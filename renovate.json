{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies (minor/patch)"
    },
    {
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dependencies (minor/patch)"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchDepNames": [
        "node"
      ],
      "matchManagers": [
        "github-actions",
        "nvm",
        "npm"
      ],
      "labels": [
        "node-runtime"
      ]
    },
    {
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": "<23"
    }
  ]
}
